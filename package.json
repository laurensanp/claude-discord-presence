{
  "name": "better-vscode-presence",
  "displayName": "Claude Discord Presence",
  "description": "Unofficial. Show what Claude Code and VS Code are working on as your Discord Rich Presence.",
  "version": "0.7.1",
  "publisher": "kevinpartizan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurensanp/claude-discord-presence"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "discord",
    "rich presence"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "tsc -p . --outDir out && mocha --ui tdd \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@nxenjs/discord-rich-presence": "^1.0.0"
  }
}
